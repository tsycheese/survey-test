# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/mydatabase

# NextAuth 配置
AUTH_SECRET=your-auth-secret-key-here-run-npx-auth-secret-to-generate

# OAuth 登录（可选，至少同时配置同一 Provider 的 ID 和 Secret）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# DeepSeek AI (可选)
DEEPSEEK_API_KEY=your-deepseek-api-key

# Cloudinary (图片存储)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# 实时协作提供方：默认 pusher；本地开发可改为 soketi
REALTIME_PROVIDER=pusher
NEXT_PUBLIC_REALTIME_PROVIDER=pusher

# 性能诊断日志（客户端与服务端）
NEXT_PUBLIC_ENABLE_PERF_LOGS=false

# Pusher（云端实时协作）
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=ap1

# 客户端使用的 Pusher 配置 (需要 NEXT_PUBLIC_ 前缀)
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# Soketi（本地实时协作，仅在 provider=soketi 时读取）
SOKETI_APP_ID=survey-local
SOKETI_APP_KEY=survey-local-key
SOKETI_APP_SECRET=survey-local-secret
SOKETI_HOST=127.0.0.1
SOKETI_PORT=6001
NEXT_PUBLIC_SOKETI_APP_KEY=survey-local-key
NEXT_PUBLIC_SOKETI_HOST=127.0.0.1
NEXT_PUBLIC_SOKETI_PORT=6001

# Resend (邮件发送)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
